[sub_resource type="GDScript" id="GDScript_yyfmc"]
script/source = "extends Room3D


func _ready() -> void:
	super()
	body_entered.connect(handle_player_entrance)


func handle_player_entrance(body: Node3D) -> void:
	remove_all_bounds(body)
	#rotate_player(body)

	keep_camera_on_player(body)
	bind_camera_LR(body)
	bind_camera_y(body, 2)


func _on_body_entered(body: Node3D) -> void:
	if body.is_in_group(\"player\"):
		FmodServer.set_global_parameter_by_name(\"InPartyRoom\", 1)


func _on_body_exited(body: Node3D) -> void:
	if body.is_in_group(\"player\"):
		FmodServer.set_global_parameter_by_name(\"InPartyRoom\", 0)
"

